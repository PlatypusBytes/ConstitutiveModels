
CC = gcc
CFLAGS = -fPIC -Wall -Wextra -O2 -g
LDFLAGS = -shared

# Output directories
BUILD_DIR = build_C
LIB_DIR = $(BUILD_DIR)/lib

# Source directories
C_MODELS_DIR = c_models
ELASTIC_LAWS_DIR = $(C_MODELS_DIR)/elastic_laws
LINEAR_ELASTIC_TENS_DIR = $(C_MODELS_DIR)/linear_elastic_with_vertical_tens_cutoff
LINEAR_ELASTIC_TENS_2D_INTERFACE_DIR = $(C_MODELS_DIR)/linear_elastic_with_vertical_tens_cutoff_2d_interface
LINEAR_ELASTIC_TENS_3D_INTERFACE_DIR = $(C_MODELS_DIR)/linear_elastic_with_vertical_tens_cutoff_3d_interface
MATSUOKA_NAKAI_DIR = $(C_MODELS_DIR)/matsuoka_nakai
VISCOELASTIC_KELVIN_VOIGT_DIR = $(C_MODELS_DIR)/viscoelastic_kelvin_voigt
HARDENING_SOIL_DIR = $(C_MODELS_DIR)/hardening_soil
SOFT_SOIL_DIR = $(C_MODELS_DIR)/soft_soil
YIELD_SURFACES_DIR = $(C_MODELS_DIR)/yield_surfaces
HARDENING_RULES_DIR = $(C_MODELS_DIR)/hardening_rules
FLOW_RULES_DIR = $(C_MODELS_DIR)/flow_rules
CREEP_LAWS_DIR = $(C_MODELS_DIR)/creep_laws
RETURN_MAPPINGS_DIR = $(C_MODELS_DIR)/return_mappings

# Include directories
INCLUDES = -I$(C_MODELS_DIR) -I$(ELASTIC_LAWS_DIR) -I$(YIELD_SURFACES_DIR)

# Common object files
COMMON_OBJS = \
	$(BUILD_DIR)/globals.o \
	$(BUILD_DIR)/utils.o \
	$(BUILD_DIR)/stress_utils.o \
	$(BUILD_DIR)/strain_utils.o \
	$(BUILD_DIR)/hookes_law.o

# Building blocks of the Hardening Soil model
HARDENING_SOIL_OBJS = \
	$(BUILD_DIR)/power_law_stiffness.o \
	$(BUILD_DIR)/mohr_coulomb_surface.o \
	$(BUILD_DIR)/hyperbolic_shear_surface.o \
	$(BUILD_DIR)/elliptic_cap_surface.o \
	$(BUILD_DIR)/hyperbolic_shear_hardening.o \
	$(BUILD_DIR)/cap_hardening.o \
	$(BUILD_DIR)/rowe_dilatancy.o

# Building blocks of the Soft Soil Creep model
SOFT_SOIL_CREEP_OBJS = \
	$(BUILD_DIR)/logarithmic_elasticity.o \
	$(BUILD_DIR)/modified_cam_clay_surface.o \
	$(BUILD_DIR)/mohr_coulomb_surface.o \
	$(BUILD_DIR)/modified_cam_clay_flow.o \
	$(BUILD_DIR)/exponential_volumetric_hardening.o \
	$(BUILD_DIR)/isotache_creep.o \
	$(BUILD_DIR)/mohr_coulomb_return_mapping.o

# Target shared libraries
LIBS = \
    $(LIB_DIR)/linear_elastic_with_vertical_tens_cutoff.so \
    $(LIB_DIR)/linear_elastic_with_vertical_tens_cutoff_2d_interface.so \
    $(LIB_DIR)/linear_elastic_with_vertical_tens_cutoff_3d_interface.so \
    $(LIB_DIR)/matsuoka_nakai.so \
    $(LIB_DIR)/viscoelastic_kelvin_voigt.so \
    $(LIB_DIR)/hardening_soil.so \
    $(LIB_DIR)/soft_soil_creep.so

# Default target
all: directories $(LIBS)

# Create necessary directories
directories:
	mkdir -p $(BUILD_DIR)
	mkdir -p $(LIB_DIR)

# Common object files compilation
$(BUILD_DIR)/globals.o: $(C_MODELS_DIR)/globals.c $(C_MODELS_DIR)/globals.h
	$(CC) $(CFLAGS) $(INCLUDES) -c $< -o $@

$(BUILD_DIR)/utils.o: $(C_MODELS_DIR)/utils.c $(C_MODELS_DIR)/utils.h
	$(CC) $(CFLAGS) $(INCLUDES) -c $< -o $@

$(BUILD_DIR)/stress_utils.o: $(C_MODELS_DIR)/stress_utils.c $(C_MODELS_DIR)/stress_utils.h
	$(CC) $(CFLAGS) $(INCLUDES) -c $< -o $@

$(BUILD_DIR)/hookes_law.o: $(ELASTIC_LAWS_DIR)/hookes_law.c $(ELASTIC_LAWS_DIR)/hookes_law.h
	$(CC) $(CFLAGS) $(INCLUDES) -c $< -o $@

$(BUILD_DIR)/strain_utils.o: $(C_MODELS_DIR)/strain_utils.c $(C_MODELS_DIR)/strain_utils.h
	$(CC) $(CFLAGS) $(INCLUDES) -c $< -o $@

# Hardening Soil building blocks: stiffness, yield surfaces, hardening and flow rules
$(BUILD_DIR)/power_law_stiffness.o: $(ELASTIC_LAWS_DIR)/power_law_stiffness.c $(ELASTIC_LAWS_DIR)/power_law_stiffness.h
	$(CC) $(CFLAGS) $(INCLUDES) -c $< -o $@

$(BUILD_DIR)/mohr_coulomb_surface.o: $(YIELD_SURFACES_DIR)/mohr_coulomb_surface.c $(YIELD_SURFACES_DIR)/mohr_coulomb_surface.h
	$(CC) $(CFLAGS) $(INCLUDES) -c $< -o $@

$(BUILD_DIR)/hyperbolic_shear_surface.o: $(YIELD_SURFACES_DIR)/hyperbolic_shear_surface.c $(YIELD_SURFACES_DIR)/hyperbolic_shear_surface.h
	$(CC) $(CFLAGS) $(INCLUDES) -c $< -o $@

$(BUILD_DIR)/elliptic_cap_surface.o: $(YIELD_SURFACES_DIR)/elliptic_cap_surface.c $(YIELD_SURFACES_DIR)/elliptic_cap_surface.h
	$(CC) $(CFLAGS) $(INCLUDES) -c $< -o $@

$(BUILD_DIR)/hyperbolic_shear_hardening.o: $(HARDENING_RULES_DIR)/hyperbolic_shear_hardening.c $(HARDENING_RULES_DIR)/hyperbolic_shear_hardening.h
	$(CC) $(CFLAGS) $(INCLUDES) -c $< -o $@

$(BUILD_DIR)/cap_hardening.o: $(HARDENING_RULES_DIR)/cap_hardening.c $(HARDENING_RULES_DIR)/cap_hardening.h
	$(CC) $(CFLAGS) $(INCLUDES) -c $< -o $@

$(BUILD_DIR)/rowe_dilatancy.o: $(FLOW_RULES_DIR)/rowe_dilatancy.c $(FLOW_RULES_DIR)/rowe_dilatancy.h
	$(CC) $(CFLAGS) $(INCLUDES) -c $< -o $@

# Soft Soil Creep building blocks: elasticity, surface, flow, hardening, creep and failure
$(BUILD_DIR)/logarithmic_elasticity.o: $(ELASTIC_LAWS_DIR)/logarithmic_elasticity.c $(ELASTIC_LAWS_DIR)/logarithmic_elasticity.h
	$(CC) $(CFLAGS) $(INCLUDES) -c $< -o $@

$(BUILD_DIR)/modified_cam_clay_surface.o: $(YIELD_SURFACES_DIR)/modified_cam_clay_surface.c $(YIELD_SURFACES_DIR)/modified_cam_clay_surface.h
	$(CC) $(CFLAGS) $(INCLUDES) -c $< -o $@

$(BUILD_DIR)/modified_cam_clay_flow.o: $(FLOW_RULES_DIR)/modified_cam_clay_flow.c $(FLOW_RULES_DIR)/modified_cam_clay_flow.h
	$(CC) $(CFLAGS) $(INCLUDES) -c $< -o $@

$(BUILD_DIR)/exponential_volumetric_hardening.o: $(HARDENING_RULES_DIR)/exponential_volumetric_hardening.c $(HARDENING_RULES_DIR)/exponential_volumetric_hardening.h
	$(CC) $(CFLAGS) $(INCLUDES) -c $< -o $@

$(BUILD_DIR)/isotache_creep.o: $(CREEP_LAWS_DIR)/isotache_creep.c $(CREEP_LAWS_DIR)/isotache_creep.h
	$(CC) $(CFLAGS) $(INCLUDES) -c $< -o $@

$(BUILD_DIR)/mohr_coulomb_return_mapping.o: $(RETURN_MAPPINGS_DIR)/mohr_coulomb_return_mapping.c $(RETURN_MAPPINGS_DIR)/mohr_coulomb_return_mapping.h
	$(CC) $(CFLAGS) $(INCLUDES) -c $< -o $@

# Matsuoka-Nakai yield surface
$(BUILD_DIR)/matsuoka_nakai_surface.o: $(YIELD_SURFACES_DIR)/matsuoka_nakai_surface.c $(YIELD_SURFACES_DIR)/matsuoka_nakai_surface.h
	$(CC) $(CFLAGS) $(INCLUDES) -c $< -o $@

# Linear elastic with vertical tension cutoff model
$(BUILD_DIR)/linear_elastic_with_vertical_tens_cutoff.o: $(LINEAR_ELASTIC_TENS_DIR)/linear_elastic_with_vertical_tens_cutoff.c
	$(CC) $(CFLAGS) $(INCLUDES) -c $< -o $@

# Linear elastic with vertical tension cutoff model for 2d interface
$(BUILD_DIR)/linear_elastic_with_vertical_tens_cutoff_2d_interface.o: $(LINEAR_ELASTIC_TENS_2D_INTERFACE_DIR)/linear_elastic_with_vertical_tens_cutoff_2d_interface.c
	$(CC) $(CFLAGS) $(INCLUDES) -c $< -o $@

# Linear elastic with vertical tension cutoff model for 3d interface
$(BUILD_DIR)/linear_elastic_with_vertical_tens_cutoff_3d_interface.o: $(LINEAR_ELASTIC_TENS_3D_INTERFACE_DIR)/linear_elastic_with_vertical_tens_cutoff_3d_interface.c
	$(CC) $(CFLAGS) $(INCLUDES) -c $< -o $@

# Matsuoka-Nakai model
$(BUILD_DIR)/matsuoka_nakai.o: $(MATSUOKA_NAKAI_DIR)/matsuoka_nakai.c
	$(CC) $(CFLAGS) $(INCLUDES) -c $< -o $@

# Viscoelastic Kelvin-Voigt model
$(BUILD_DIR)/viscoelastic_kelvin_voigt.o: $(VISCOELASTIC_KELVIN_VOIGT_DIR)/viscoelastic_kelvin_voigt.c
	$(CC) $(CFLAGS) $(INCLUDES) -c $< -o $@

# Hardening Soil model
$(BUILD_DIR)/hardening_soil.o: $(HARDENING_SOIL_DIR)/hardening_soil.c
	$(CC) $(CFLAGS) $(INCLUDES) -c $< -o $@

# Soft Soil Creep model
$(BUILD_DIR)/soft_soil_creep.o: $(SOFT_SOIL_DIR)/soft_soil_creep.c
	$(CC) $(CFLAGS) $(INCLUDES) -c $< -o $@

# Shared libraries
$(LIB_DIR)/linear_elastic_with_vertical_tens_cutoff.so: $(COMMON_OBJS) $(BUILD_DIR)/linear_elastic_with_vertical_tens_cutoff.o
	$(CC) $(LDFLAGS) -o $@ $^

$(LIB_DIR)/linear_elastic_with_vertical_tens_cutoff_2d_interface.so: $(COMMON_OBJS) $(BUILD_DIR)/linear_elastic_with_vertical_tens_cutoff_2d_interface.o
	$(CC) $(LDFLAGS) -o $@ $^

$(LIB_DIR)/linear_elastic_with_vertical_tens_cutoff_3d_interface.so: $(COMMON_OBJS) $(BUILD_DIR)/linear_elastic_with_vertical_tens_cutoff_3d_interface.o
	$(CC) $(LDFLAGS) -o $@ $^

$(LIB_DIR)/matsuoka_nakai.so: $(COMMON_OBJS) $(BUILD_DIR)/matsuoka_nakai_surface.o $(BUILD_DIR)/matsuoka_nakai.o
	$(CC) $(LDFLAGS) -o $@ $^

$(LIB_DIR)/viscoelastic_kelvin_voigt.so: $(COMMON_OBJS) $(BUILD_DIR)/viscoelastic_kelvin_voigt.o
	$(CC) $(LDFLAGS) -o $@ $^

$(LIB_DIR)/hardening_soil.so: $(COMMON_OBJS) $(HARDENING_SOIL_OBJS) $(BUILD_DIR)/hardening_soil.o
	$(CC) $(LDFLAGS) -o $@ $^ -lm

$(LIB_DIR)/soft_soil_creep.so: $(COMMON_OBJS) $(SOFT_SOIL_CREEP_OBJS) $(BUILD_DIR)/soft_soil_creep.o
	$(CC) $(LDFLAGS) -o $@ $^ -lm

# Clean target
clean:
	rm -rf $(BUILD_DIR)

# Help target
help:
	@echo "Available targets:"
	@echo "  all       - Build all shared libraries (default)"
	@echo "  clean     - Remove all build artifacts"
	@echo "  help      - Show this help message"

.PHONY: all directories clean help